        { "texte": "Oui, c'est cool.", "identifiantRepliqueSuivante": "laFOretCestCool"}]
      },
      "pourquoiLaForetCestCool": {
        "texte": "Mais parce qu'il y a plein d'arbres, et que les arbres, c'est cool. Ça donne de l'oxygène gratuit.",
        "choix": [{ "texte": "Ah", "identifiantRepliqueSuivante": "ah"}]
      },
      "ah": {
        "texte": "On n'y pense pas souvent mais, dans 20, 30 ans, y'en aura plus.",
        "choix": [{ "texte": "... De l'eau ?", "identifiantRepliqueSuivante": "deLeau"}]
      },
      "deLeau": {
        "texte": "Non, du pain.",
        "choix": [{ "texte": "Euh... ", "identifiantRepliqueSuivante": "duPain"}]
      },
      "duPain": {
        "texte": "Mais oui, de l'eau ! Bon, je vous ferai remarquer que nous parlions d'oxygène, initialement.",
        "choix": [{ "texte": "Ah oui", "identifiantRepliqueSuivante": "ahOui"},
        { "texte": "Initialement.", "identifiantRepliqueSuivante": "ahOui"}]
      },
      "ahOui": {
        "texte": "Nice.",
        "choix": [{ "texte": "Marseille", "identifiantRepliqueSuivante": "marseille"}]
      },
      "marseille": {
        "texte": "MARSEEEILLE !",
        "choix": []
      },
      "laFOretCestCool": {
        "texte": "C'est vraiment cool.",
        "choix": []
      }
    },
    "densiteSol": "peu",
    "densiteHerbe": "beaucoup",
    "densiteNuage": "peu",
    "densiteAir": "normal"
  },
  "etreDeux": {
